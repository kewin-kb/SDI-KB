<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#FFFFFF">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Encabezado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="#FFFFFF">

                <TextView
                    android:id="@+id/menuHamburguesa"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="☰"
                    android:textColor="#3028FF"
                    android:textSize="26sp"
                    android:clickable="true"
                    android:focusable="true"/>

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    app:srcCompat="@drawable/logo" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#3028FF"/>

            <!-- Título -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="DASHBOARD"
                android:textColor="#111111"
                android:textSize="19sp"
                android:textStyle="bold"
                android:padding="4dp"/>

            <!-- Botones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnNuevoEquipo"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="2dp"
                    android:text="+ Nuevo equipo"
                    android:textAllCaps="false"
                    android:textSize="9sp"
                    android:backgroundTint="#3028FF"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/btnNuevoColaborador"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1.25"
                    android:layout_margin="2dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="2dp"
                    android:text="+ Nuevo colaborador"
                    android:textAllCaps="false"
                    android:textSize="8sp"
                    android:backgroundTint="#3028FF"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/btnAsignarEquipo"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="2dp"
                    android:text="+ Asignar equipo"
                    android:textAllCaps="false"
                    android:textSize="8sp"
                    android:backgroundTint="#3028FF"
                    android:textColor="#FFFFFF"/>

            </LinearLayout>

            <!-- Indicadores: fila 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="82dp"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:orientation="vertical"
                    android:padding="7dp"
                    android:background="#D7E9F8">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Total equipos"
                        android:textStyle="bold"
                        android:textColor="#111111"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/txtTotalEquipos"
                        android:layout_width="127dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="150"
                        android:textColor="#000000"
                        android:textSize="29sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="82dp"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:orientation="vertical"
                    android:padding="7dp"
                    android:background="#D9EBD9">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Disponibles"
                        android:textStyle="bold"
                        android:textColor="#111111"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/txtDisponibles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="20"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="29sp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Indicadores: fila 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="82dp"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:orientation="vertical"
                    android:padding="7dp"
                    android:background="#D7E9F8">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Asignados"
                        android:textStyle="bold"
                        android:textColor="#111111"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/txtAsignados"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="110"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="29sp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="82dp"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:orientation="vertical"
                    android:padding="7dp"
                    android:background="#E4E4E4">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="De baja"
                        android:textStyle="bold"
                        android:textColor="#111111"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/txtDeBaja"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="20"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="29sp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Celulares -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_margin="3dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="#E1E1E1">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Total celulares"
                    android:textColor="#111111"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gama alta                         20"
                    android:textColor="#111111"
                    android:textStyle="bold"
                    android:textSize="12sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gama media                      50"
                    android:textColor="#111111"
                    android:textStyle="bold"
                    android:textSize="12sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gama baja                         10"
                    android:textColor="#111111"
                    android:textStyle="bold"
                    android:textSize="12sp"/>

            </LinearLayout>

            <!-- Alertas -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Alertas importantes"
                android:textColor="#111111"
                android:textStyle="bold"
                android:textSize="16sp"
                android:padding="5dp"/>

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="*"
                android:background="#EEEEEE">

                <TableRow android:background="#D5D5D5">
                    <TextView android:text="Prioridad" android:textStyle="bold" android:textSize="9sp" android:padding="3dp"/>
                    <TextView android:text="Servicio" android:textStyle="bold" android:textSize="9sp" android:padding="3dp"/>
                    <TextView android:text="Vencimiento" android:textStyle="bold" android:textSize="9sp" android:padding="3dp"/>
                    <TextView android:text="Costo" android:textStyle="bold" android:textSize="9sp" android:padding="3dp"/>
                </TableRow>

                <TableRow>
                    <TextView android:text="Alta" android:textSize="8sp" android:padding="3dp"/>
                    <TextView android:text="Revisión portátil" android:textSize="8sp" android:padding="3dp"/>
                    <TextView android:text="10/11/2026" android:textSize="8sp" android:padding="3dp"/>
                    <TextView android:text="$150.000" android:textSize="8sp" android:padding="3dp"/>
                </TableRow>

                <TableRow>
                    <TextView android:text="Media" android:textSize="8sp" android:padding="3dp"/>
                    <TextView android:text="Mantenimiento PC" android:textSize="8sp" android:padding="3dp"/>
                    <TextView android:text="15/11/2026" android:textSize="8sp" android:padding="3dp"/>
                    <TextView android:text="$80.000" android:textSize="8sp" android:padding="3dp"/>
                </TableRow>

                <TableRow>
                    <TextView android:text="Alta" android:textSize="8sp" android:padding="3dp"/>
                    <TextView android:text="Antivirus AVAST" android:textSize="8sp" android:padding="3dp"/>
                    <TextView android:text="20/11/2026" android:textSize="8sp" android:padding="3dp"/>
                    <TextView android:text="$65.000" android:textSize="8sp" android:padding="3dp"/>
                </TableRow>

            </TableLayout>

            <!-- Últimas modificaciones -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Últimas modificaciones"
                android:textColor="#111111"
                android:textStyle="bold"
                android:textSize="16sp"
                android:padding="5dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true">

                <TableLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*"
                    android:background="#EEEEEE">

                    <TableRow android:background="#D5D5D5">
                        <TextView android:text="Tipo" android:textStyle="bold" android:textSize="9sp" android:padding="4dp"/>
                        <TextView android:text="Serial" android:textStyle="bold" android:textSize="9sp" android:padding="4dp"/>
                        <TextView android:text="Marca" android:textStyle="bold" android:textSize="9sp" android:padding="4dp"/>
                        <TextView android:text="Modelo" android:textStyle="bold" android:textSize="9sp" android:padding="4dp"/>
                        <TextView android:text="Estado" android:textStyle="bold" android:textSize="9sp" android:padding="4dp"/>
                        <TextView android:text="Fecha" android:textStyle="bold" android:textSize="9sp" android:padding="4dp"/>
                    </TableRow>

                    <TableRow>
                        <TextView android:text="Portátil" android:textSize="8sp" android:padding="4dp"/>
                        <TextView android:text="SN458741" android:textSize="8sp" android:padding="4dp"/>
                        <TextView android:text="Lenovo" android:textSize="8sp" android:padding="4dp"/>
                        <TextView android:text="ThinkPad E14" android:textSize="8sp" android:padding="4dp"/>
                        <TextView android:text="Asignado" android:textSize="8sp" android:padding="4dp"/>
                        <TextView android:text="03/10/2026" android:textSize="8sp" android:padding="4dp"/>
                    </TableRow>

                    <TableRow>
                        <TextView android:text="PC escritorio" android:textSize="8sp" android:padding="4dp"/>
                        <TextView android:text="SN662351" android:textSize="8sp" android:padding="4dp"/>
                        <TextView android:text="Dell" android:textSize="8sp" android:padding="4dp"/>
                        <TextView android:text="OptiPlex 7090" android:textSize="8sp" android:padding="4dp"/>
                        <TextView android:text="Disponible" android:textSize="8sp" android:padding="4dp"/>
                        <TextView android:text="02/10/2026" android:textSize="8sp" android:padding="4dp"/>
                    </TableRow>

                    <TableRow>
                        <TextView android:text="Monitor" android:textSize="8sp" android:padding="4dp"/>
                        <TextView android:text="SN774125" android:textSize="8sp" android:padding="4dp"/>
                        <TextView android:text="Samsung" android:textSize="8sp" android:padding="4dp"/>
                        <TextView android:text="F24T350" android:textSize="8sp" android:padding="4dp"/>
                        <TextView android:text="Disponible" android:textSize="8sp" android:padding="4dp"/>
                        <TextView android:text="30/09/2026" android:textSize="8sp" android:padding="4dp"/>
                    </TableRow>

                </TableLayout>

            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- Menú lateral -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu"/>

</androidx.drawerlayout.widget.DrawerLayout>
